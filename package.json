{
  "name": "roblox-launcher",
  "productName": "Roblox Launcher",
  "version": "1.0.8",
  "description": "Launcher de Roblox con pestañas: jugar, comprobar versión, abrir carpetas y más.",
  "main": "main.js",
  "author": "Tu nombre <tu@email.com>",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "publish": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.robloxlauncher.app",
    "productName": "Roblox Launcher",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Roblox-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Roblox Launcher"
    },
    "publish": {
      "provider": "github",
      "owner": "Jairoxdhola",
      "repo": "roblox-launcher"
    }
  },
  "keywords": [
    "roblox",
    "launcher",
    "electron"
  ],
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
